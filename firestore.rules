rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    // For now, we'll assume any authenticated user is an admin since we only have admin login
    // In a real app with multiple roles, you'd check request.auth.token.role == 'admin'
    function isAdmin() {
      return request.auth != null;
    }

    // Tours collection
    match /tours/{tourId} {
      // Public read access for all tours (filtering active ones is done in query)
      allow read: if true;
      
      // Only admins can create, update, or delete tours
      allow write: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Anyone can create a booking (public checkout)
      allow create: if true;
      
      // Only admins can read (list), update (status), or delete bookings
      allow read, update, delete: if isAdmin();
    }
  }
}
